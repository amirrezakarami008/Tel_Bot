# --- Bot ---
BOT_TOKEN=

# --- Admin ---
ADMIN_TELEGRAM_IDS=123456789,987654321   # لیست شناسه‌های عددی ادمین، جدا شده با کاما

# --- Required channels (اختیاری؛ فقط برای seed اولیه) ---
# اگر جدول کانال‌ها خالی باشد، از اینجا یک‌بار وارد دیتابیس می‌شود.
# بعد از آن کانال‌ها را از «⚙️ مدیریت منو» اضافه/حذف کنید.
REQUIRED_CHANNELS=@channel_one,@channel_two

# --- Feature 1: Webinar (اختیاری؛ فقط برای اولین راه‌اندازی) ---
# اگر هنوز وبیناری در پنل ادمین نساخته‌اید و این لینک پر باشد، یک وبینار اولیه ساخته می‌شود.
# بعد از آن لینک و دکمه را از «⚙️ مدیریت منو» بسازید یا تغییر دهید.
WEBINAR_LINK=

# --- Feature 3: Gift PDF files ---
# مسیر پوشه‌ای که فایل‌های PDF هدیه داخلش قرار دارند
GIFT_FILES_DIR=./gift_files

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/botdb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Misc ---
LOG_LEVEL=INFO

# --- Proxy (اگر تلگرام فیلتر است) ---
# TELEGRAM_PROXY=http://host.docker.internal:7890
TELEGRAM_PROXY=

# --- Local Bot API (برای فایل‌های بزرگ‌تر از محدودیت API عمومی) ---
# برای پشتیبانی فایل هدیه تا ۱۰۰MB، این دو آدرس را فعال کنید.
# مقدارها برای docker-compose با profile=large-files:
# TELEGRAM_API_BASE_URL=http://telegram-api:8081/bot
# TELEGRAM_API_FILE_BASE_URL=http://telegram-api:8081/file/bot
TELEGRAM_API_BASE_URL=
TELEGRAM_API_FILE_BASE_URL=
GIFT_MAX_FILE_SIZE_MB=100
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Build / pip (اگر نصب پکیج‌ها در Docker fail شد) ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=
PIP_INDEX_URL=https://pypi.org/simple
